{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guardrail Attestation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "operations"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 80
    },
    "checkList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "advisory"],
      "properties": {
        "required": { "$ref": "#/$defs/checkList" },
        "advisory": { "$ref": "#/$defs/checkList" }
      }
    }
  }
}
