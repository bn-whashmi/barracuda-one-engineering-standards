{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guardrail Attestation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "subject", "checks"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "revision"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 80
        },
        "revision": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "maxLength": 80
      },
      "additionalProperties": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "status"],
      "properties": {
        "producer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": {
          "enum": ["passed", "failed", "blocked", "not_run"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["passed", "failed"] }
            },
            "required": ["status"]
          },
          "then": { "required": ["evidence"] }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["blocked", "not_run"] }
            },
            "required": ["status"]
          },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
